# ======================================================
# Treehole Windows Native Runtime Environment Template
# Copy this file to C:\treehole\.env and replace placeholders.
# Do not commit real passwords, API keys, or private host values.
# ======================================================

SPRING_PROFILES_ACTIVE=prod
BACKEND_PORT=24191

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=<PLACEHOLDER_DB_NAME>
DB_USER=<PLACEHOLDER_DB_USER>
DB_USER_PASSWORD=<PLACEHOLDER_DB_PASSWORD>

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

AI_API_KEY=<PLACEHOLDER_AI_API_KEY>

UPLOAD_PATH=C:/treehole/storage/uploads
LOG_PATH=C:/treehole/storage/logs
