# 强制所有文件在提交时转换为 LF，并在检出时保持
* text=auto eol=lf

# 明确指定脚本文件必须使用 LF
*.sh text eol=lf
backend/mvnw text eol=lf
frontend/nginx.conf text eol=lf

# 常见的文本文件
*.java text
*.vue text
*.js text
*.css text
*.html text
*.yaml text
*.yml text
*.json text
*.sql text
*.md text
.gitignore text
.dockerignore text
.env.example text

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp3 binary
*.webm binary
*.wav binary
*.jar binary
*.war binary
