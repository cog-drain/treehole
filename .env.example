# ======================================================
# 赛博树洞 (Treehole) - 环境变量配置模板
# 复制此文件并重命名为 .env，填入你自己的真实密码和密钥
# ======================================================

# 数据库 root 密码（仅数据库容器初始化/运维使用）
DB_ROOT_PASSWORD=YOUR_STRONG_ROOT_PASSWORD_HERE

# 智谱 AI / Gemini 的 API 密钥 (用于语义分析与 Alter Ego)
AI_API_KEY=YOUR_AI_API_KEY_HERE

# 数据库业务账户（后端应用实际连接数据库使用）
DB_USER=treehole_user
DB_USER_PASSWORD=treehole_pass
DB_NAME=treehole

# 服务器运行端口暴露配置 (宿主机端口)
FRONTEND_PORT=
BACKEND_PORT=24191
DB_PORT=3306

# 前端环境变量 (Vite 专用，需以 VITE_ 开头)
# 注意：此变量通常应放在 frontend/.env 中，此处仅作模板参考
VITE_API_BASE_URL=http://localhost:24191/api
