# 1. 忽略构建产物
backend/target/
**/target/
*.jar
*.war

# 2. 忽略前端产物
frontend/node_modules/
**/node_modules/
frontend/dist/
frontend/dist-ssr/

# 3. 忽略机密文件（极其重要！）
.env
.env.local
.env.*.local
*.pem
*.key

# 4. 忽略本地持久化数据（防止镜像过大）
backend/uploads/
db_data/
mysql_data/
uploads_data/

# 5. 忽略 Git 和 IDE
.git/
.gitignore
.github/
.idea/
.vscode/
*.iml

# 6. 其他
*.log
Dockerfile
docker-compose.yml
.dockerignore
