{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
    "exclude": ["src/**/__tests__/*", "dist", "node_modules"],
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"]
        },
        "allowJs": false,
        "noEmit": true,
        "strict": false,
        "strictNullChecks": true,
        "noUncheckedIndexedAccess": true,
        "composite": true,
        "ignoreDeprecations": "6.0",
        "types": ["vite/client"]
    }
}
