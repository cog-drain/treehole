# ======================================================
# Treehole Windows Demo Runtime Environment Template
# Copy this file to C:\treehole-demo\.env and replace placeholders.
# Do not commit real passwords, API keys, or private host values.
# ======================================================

SPRING_PROFILES_ACTIVE=demo
BACKEND_PORT=24191

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=treehole
DB_USER=<YOUR_DB_USER>
DB_USER_PASSWORD=<YOUR_DB_PASSWORD>

AI_API_KEY=<YOUR_AI_API_KEY>

FRONTEND_PATH=C:/treehole-demo/frontend
UPLOAD_PATH=C:/treehole-demo/storage/uploads
LOG_PATH=C:/treehole-demo/storage/logs
